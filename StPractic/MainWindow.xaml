<Window x:Class="StPractic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIPLang - Изучение языков"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}"
        Icon="Images/logo.png"
        Closing="ClosedProg">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Logo_Click"
                        Cursor="Hand"
                        Padding="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Images/logo.png" Width="36" Height="36"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0"/>
                        <TextBlock Text="KIPLang" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushAccent}"/>
                    </StackPanel>
                </Button>

                <!-- Тумблер темы -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <TextBlock Text="☀" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,8,0"/>
                    <ToggleButton x:Name="ThemeSwitch"
                                  Style="{DynamicResource ThemeToggleStyle}"
                                  Checked="ThemeSwitch_Checked"
                                  Unchecked="ThemeSwitch_Unchecked"
                                  ToolTip="Смена темы"/>
                    <TextBlock Text="🌙" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Кнопки справа -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LoginBtn" Content="Войти / Регистрация"
                            Padding="15,5" Click="LoginBtn_Click"/>
                    <StackPanel x:Name="AuthPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="ProfileBtn" Content="Мой профиль"
                                Padding="15,5" Margin="0,0,10,0" Click="ProfileBtn_Click"/>
                        <Button Content="Выйти" Padding="15,5"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BrushBorder}"
                                Foreground="{DynamicResource BrushTextPrimary}"
                                Click="LogoutBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Source="Pages/CourseCatalogPage.xaml"/>
    </Grid>
</Window>