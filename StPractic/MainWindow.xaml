<Window x:Class="StPractic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIPLang - Изучение языков" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Контент (Страницы) -->
        </Grid.RowDefinitions>

        <!-- Шапка сайта -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип / Название (Кликабельный, ведет на главную) -->
                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Click="Logo_Click" Cursor="Hand">
                    <TextBlock Text="KIPLang" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                </Button>

                <!-- Кнопки справа -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Эта кнопка видна, если пользователь НЕ авторизован -->
                    <Button x:Name="LoginBtn" Content="Войти / Регистрация" Padding="15,5" Click="LoginBtn_Click"/>

                    <!-- Эти кнопки видны, если пользователь АВТОРИЗОВАН -->
                    <StackPanel x:Name="AuthPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="ProfileBtn" Content="Мой профиль" Padding="15,5" Margin="0,0,10,0" Click="ProfileBtn_Click"/>
                        <Button Content="Выйти" Padding="15,5" Background="Transparent" BorderBrush="{DynamicResource BrushBorder}" 
                                Foreground="{DynamicResource BrushTextPrimary}" Click="LogoutBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Сюда загружаются страницы -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Source="Pages/CourseCatalogPage.xaml"/>
    </Grid>
</Window>