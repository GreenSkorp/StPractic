<Page x:Class="StPractic.Pages.CoursePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Страница курса"
      Background="{DynamicResource BrushBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Кнопка назад + заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Информация о курсе -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопка записи -->
                <RowDefinition Height="Auto"/>
                <!-- Уроки -->
                <RowDefinition Height="Auto"/>
                <!-- Отзывы -->
            </Grid.RowDefinitions>

            <!-- ===== ВЕРХНЯЯ ПАНЕЛЬ ===== -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="BackBtn" Content="← Назад к каталогу" 
                        Padding="12,6" Click="BackBtn_Click"
                        Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"
                        Foreground="{DynamicResource BrushTextPrimary}" Cursor="Hand"/>
            </StackPanel>

            <!-- ===== КАРТОЧКА КУРСА ===== -->
            <Border Grid.Row="1" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="25" Margin="0,0,0,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CourseTitleText" Text="Название курса"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <WrapPanel Margin="0,0,0,15">
                            <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,4" Margin="0,0,10,5">
                                <TextBlock x:Name="LanguageText" Text="Язык" FontSize="13"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,4" Margin="0,0,10,5">
                                <TextBlock x:Name="LevelText" Text="Уровень" FontSize="13"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,4" Margin="0,0,10,5">
                                <TextBlock x:Name="DurationText" Text="0 мин" FontSize="13"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                            <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="10,4" Margin="0,0,10,5">
                                <TextBlock x:Name="RatingText" Text="★ 0.0" FontSize="13"
                                           Foreground="{DynamicResource BrushWarning}"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Описание" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DescriptionText" Text="Описание курса..."
                                   FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   LineHeight="22" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Преподаватель: " FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock x:Name="TeacherText" Text="—" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>
                        <TextBlock x:Name="CreatedAtText" Text="" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Правая колонка: цена + кнопка -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="30,0,0,0" MinWidth="180">
                        <TextBlock x:Name="PriceText" Text="0 ₽" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushAccent}"
                                   HorizontalAlignment="Right" Margin="0,0,0,15"/>

                        <Button x:Name="EnrollBtn" Content="Записаться на курс"
                                Height="42" FontSize="15" FontWeight="SemiBold"
                                Click="EnrollBtn_Click" Cursor="Hand"
                                Visibility="Collapsed"/>

                        <Border x:Name="EnrolledBadge" Background="{DynamicResource BrushSuccess}"
                                CornerRadius="8" Padding="12,8" Visibility="Collapsed"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="✓ Вы записаны" Foreground="White"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="LoginHintText" Text="Войдите, чтобы записаться"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== СПИСОК УРОКОВ ===== -->
            <Border Grid.Row="2" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="25" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Программа курса" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                    <ItemsControl x:Name="LessonsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurfaceAlt}"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,0,0,10" Padding="15,12"
                                        Cursor="Hand" MouseLeftButtonUp="Lesson_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                Background="{DynamicResource BrushAccent}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OrderNum}" Foreground="White"
                                                       FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="→" FontSize="18"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoLessonsText" Text="Уроки пока не добавлены"
                               FontSize="14" Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ===== ОТЗЫВЫ ===== -->
            <Border Grid.Row="3" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="25">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Отзывы" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReviewsCountText" Text="0 отзывов"
                                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl x:Name="ReviewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurfaceAlt}"
                                        CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Stars}" Foreground="{DynamicResource BrushWarning}"
                                                           FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,8,0,0" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoReviewsText" Text="Отзывов пока нет. Будьте первым!"
                               FontSize="14" Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>