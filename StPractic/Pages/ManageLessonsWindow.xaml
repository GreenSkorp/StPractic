<Window x:Class="StPractic.Pages.ManageLessonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уроки курса" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBackground}">

    <Grid Margin="20" Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Уроки курса" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="LessonsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" BorderThickness="0"
                  Background="Transparent" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderNum}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Длительность" Binding="{Binding DurationText}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма добавления -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="Добавить урок" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTitleBox" Height="32" VerticalContentAlignment="Center"
                             ToolTip="Название урока"/>
                    <TextBox Grid.Column="2" x:Name="NewDurationBox" Height="32"
                             VerticalContentAlignment="Center" Text="30" ToolTip="Минуты"/>
                    <Button Grid.Column="4" Content="Добавить" Padding="14,6"
                            Click="AddLesson_Click" Cursor="Hand"/>
                </Grid>
                <TextBox x:Name="NewContentBox" Height="60" Margin="0,10,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         ToolTip="Текст материала урока"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="3" Content="Закрыть" Padding="16,8" Margin="0,15,0,0"
                HorizontalAlignment="Right" Click="Close_Click" Cursor="Hand"
                Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"
                Foreground="{DynamicResource BrushTextPrimary}"/>
    </Grid>
</Window>