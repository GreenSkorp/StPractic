<Window x:Class="StPractic.Pages.CourseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Курс" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Создание курса" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Описание" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="DescBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Язык" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageCombo" Height="34" DisplayMemberPath="name"
                          SelectedValuePath="id" Margin="0,0,0,12"/>

                <TextBlock Text="Уровень" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <ComboBox x:Name="LevelCombo" Height="34" Margin="0,0,0,12">
                    <ComboBoxItem Content="Beginner" IsSelected="True"/>
                    <ComboBoxItem Content="Elementary"/>
                    <ComboBoxItem Content="Intermediate"/>
                    <ComboBoxItem Content="Upper-Intermediate"/>
                    <ComboBoxItem Content="Advanced"/>
                </ComboBox>

                <TextBlock Text="Цена ($)" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="PriceBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Padding="16,8" Margin="0,0,10,0" Click="Cancel_Click"
                    Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"
                    Foreground="{DynamicResource BrushTextPrimary}" Cursor="Hand"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Padding="16,8" Click="Save_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>