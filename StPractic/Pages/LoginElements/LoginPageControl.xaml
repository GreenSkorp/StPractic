<UserControl x:Class="StPractic.Pages.LoginElements.LoginPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="350">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20, 30, 20, 20" MinWidth="250">

                <TextBlock Text="Вход в систему" Foreground="{DynamicResource BrushTextPrimary}" 
                           FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Логин:" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginTextBox" Margin="0,0,0,15"/>

                <TextBlock Text="Пароль:" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>

                <Button Content="Войти" HorizontalAlignment="Stretch" Height="35" Click="LoginButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>