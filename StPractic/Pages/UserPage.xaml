<Page x:Class="StPractic.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ue="clr-namespace:StPractic.Pages.UserElements"
      mc:Ignorable="d"
      Title="Профиль"
      Background="{DynamicResource BrushBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="25" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="FullNameText" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="{DynamicResource BrushAccent}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                <TextBlock x:Name="RoleText" Foreground="{DynamicResource BrushTextOnAccent}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="LoginText" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                        <TextBlock x:Name="RegDateText" Margin="0,8,0,0" FontSize="13"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Сменить пароль" Padding="14,8" VerticalAlignment="Top"
                            Click="ChangePassword_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">
                <!-- Студент -->
                <TabItem x:Name="TabMyCourses" Header="Мои курсы">
                    <ue:MyCoursesControl x:Name="CtrlMyCourses"/>
                </TabItem>
                <TabItem x:Name="TabProgress" Header="Прогресс">
                    <ue:ProgressControl x:Name="CtrlProgress"/>
                </TabItem>
                <TabItem x:Name="TabAchievements" Header="Достижения">
                    <ue:AchievementsControl x:Name="CtrlAchievements"/>
                </TabItem>
                <TabItem x:Name="TabMyReviews" Header="Мои отзывы">
                    <ue:MyReviewsControl x:Name="CtrlMyReviews"/>
                </TabItem>

                <!-- Преподаватель -->
                <TabItem x:Name="TabTeacherCourses" Header="Мои курсы (преп.)">
                    <ue:TeacherCoursesControl x:Name="CtrlTeacherCourses"/>
                </TabItem>
                <TabItem x:Name="TabStudents" Header="Студенты">
                    <ue:TeacherStudentsControl x:Name="CtrlStudents"/>
                </TabItem>
                <TabItem x:Name="TabTeacherStats" Header="Статистика (преп.)">
                    <ue:TeacherStatsControl x:Name="CtrlTeacherStats"/>
                </TabItem>

                <!-- Админ -->
                <TabItem x:Name="TabUsers" Header="Пользователи">
                    <ue:AdminUsersControl x:Name="CtrlUsers"/>
                </TabItem>
                <TabItem x:Name="TabAllCourses" Header="Все курсы">
                    <ue:AdminAllCoursesControl x:Name="CtrlAllCourses"/>
                </TabItem>
                <TabItem x:Name="TabModeration" Header="Модерация отзывов">
                    <ue:AdminModerationControl x:Name="CtrlModeration"/>
                </TabItem>
                <TabItem x:Name="TabAdminStats" Header="Статистика">
                    <ue:AdminStatsControl x:Name="CtrlAdminStats"/>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</Page>