<Page x:Class="StPractic.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Мой профиль"
      Background="{DynamicResource BrushBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== ШАПКА ПРОФИЛЯ ===================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="FullNameText"
                                   Text="Имя Фамилия"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="{DynamicResource BrushAccent}"
                                    CornerRadius="6"
                                    Padding="10,3"
                                    Margin="0,0,12,0">
                                <TextBlock x:Name="RoleText"
                                           Text="Студент"
                                           FontSize="13"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="LoginText"
                                       Text="@login"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="RegDateText"
                                   Text="Дата регистрации: —"
                                   FontSize="13"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Сменить пароль"
                                Padding="14,8"
                                Click="ChangePassword_Click"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BrushBorder}"
                                Foreground="{DynamicResource BrushTextPrimary}"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== ВКЛАДКИ (стиль TabItem из темы) ===================== -->
            <TabControl x:Name="MainTabs"
                        Grid.Row="1"
                        SelectionChanged="MainTabs_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- ===== СТУДЕНТ ===== -->
                <TabItem x:Name="TabMyCourses" Header="Мои курсы">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Мои курсы" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <ItemsControl x:Name="MyCoursesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="15"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding LevelInfo}" FontSize="13"
                                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                                    <TextBlock Text="{Binding ProgressText}" FontSize="13"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               HorizontalAlignment="Right"/>
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100"
                                                                 Width="160" Height="8" Margin="0,6,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="Продолжить →" Padding="14,8"
                                                        VerticalAlignment="Center" Cursor="Hand"
                                                        Tag="{Binding CourseId}" Click="ContinueCourse_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoCoursesText"
                                       Text="Вы ещё не записаны ни на один курс"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabProgress" Header="Прогресс">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Мой прогресс" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ProgressSummaryText" FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,15"/>

                            <DataGrid x:Name="ProgressGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Урок" Binding="{Binding LessonTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Балл" Binding="{Binding Score}" Width="80"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabAchievements" Header="Достижения">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Достижения" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <ItemsControl x:Name="AchievementsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="180" Margin="0,0,12,12" Padding="15"
                                                Background="{DynamicResource BrushSurfaceAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Opacity="{Binding Opacity}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="11"
                                                           Foreground="{DynamicResource BrushAccent}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoAchievementsText"
                                       Text="Пока нет достижений"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabMyReviews" Header="Мои отзывы">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Мои отзывы" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <ItemsControl x:Name="MyReviewsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="15"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding CourseTitle}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding Stars}" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource BrushWarning}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoReviewsText"
                                       Text="Вы ещё не оставляли отзывов"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ===== ПРЕПОДАВАТЕЛЬ ===== -->
                <TabItem x:Name="TabTeacherCourses" Header="Мои курсы (преп.)">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Мои курсы" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                                <Button Content="+ Создать курс"
                                        HorizontalAlignment="Right"
                                        Padding="14,8"
                                        Click="CreateCourse_Click"
                                        Cursor="Hand"/>
                            </Grid>

                            <ItemsControl x:Name="TeacherCoursesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="15"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding StudentsText}" FontSize="13"
                                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                                   Margin="0,0,15,0"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="13"
                                                                   Foreground="{DynamicResource BrushSuccess}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Редактировать" Padding="10,6" Margin="0,0,6,0"
                                                            Tag="{Binding CourseId}" Click="EditCourse_Click" Cursor="Hand"
                                                            Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"/>
                                                    <Button Content="Заморозить" Padding="10,6" Margin="0,0,6,0"
                                                            Tag="{Binding CourseId}" Click="FreezeCourse_Click" Cursor="Hand"
                                                            Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"/>
                                                    <Button Content="Уроки" Padding="10,6"
                                                            Tag="{Binding CourseId}" Click="ManageLessons_Click" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoTeacherCoursesText"
                                       Text="У вас пока нет созданных курсов"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabStudents" Header="Студенты">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Студенты моих курсов" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <DataGrid x:Name="StudentsGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Дата записи" Binding="{Binding DateText}" Width="120"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabTeacherStats" Header="Статистика (преп.)">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Статистика" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>
                            <TextBlock Text="Здесь будут диаграммы по вашим курсам."
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ===== АДМИН ===== -->
                <TabItem x:Name="TabUsers" Header="Пользователи">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Пользователи" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="UserSearchBox"
                                         Width="220" Height="32"
                                         HorizontalAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         TextChanged="UserSearch_TextChanged"
                                         ToolTip="Поиск по ФИО или логину"/>
                            </Grid>

                            <DataGrid x:Name="UsersGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MouseDoubleClick="UsersGrid_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="140"/>
                                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="120"/>
                                    <DataGridTextColumn Header="Дата регистрации" Binding="{Binding DateText}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabAllCourses" Header="Все курсы">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Все курсы" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <DataGrid x:Name="AllCoursesGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher}" Width="180"/>
                                    <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="100"/>
                                    <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabModeration" Header="Модерация отзывов">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Модерация отзывов" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <ItemsControl x:Name="ModerationList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurfaceAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="15"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding DateText}" FontSize="12"
                                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Удалить"
                                                        Padding="12,6"
                                                        VerticalAlignment="Top"
                                                        Cursor="Hand"
                                                        Background="{DynamicResource BrushDanger}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Tag="{Binding ReviewId}"
                                                        Click="DeleteReview_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoModerationText"
                                       Text="Отзывов нет"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="TabAdminStats" Header="Статистика">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Статистика системы" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>
                            <TextBlock x:Name="AdminStatsText"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>
    </ScrollViewer>
</Page>