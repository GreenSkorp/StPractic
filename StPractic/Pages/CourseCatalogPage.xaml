<Page x:Class="StPractic.Pages.CourseCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" Title="Каталог курсов"
      Background="{DynamicResource BrushBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Доступные курсы" FontSize="28" FontWeight="Bold" 
                   Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

        <!-- Панель фильтров -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" 
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <WrapPanel>
                <!-- Поиск -->
                <TextBlock Text="Поиск:" VerticalAlignment="Center" 
                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" 
                         Width="300" Height="30" Margin="0,0,30,0" ToolTip="Поиск по названию курса" VerticalContentAlignment="Center"/>

                <!-- Фильтр по языку -->
                <TextBlock Text="Язык:" VerticalAlignment="Center" 
                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="LanguageFilterComboBox" SelectionChanged="LanguageFilterComboBox_SelectionChanged" 
                          Width="200" Height="30" DisplayMemberPath="Name" VerticalContentAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Список курсов -->
        <ListView x:Name="CoursesListView" Grid.Row="2" 
                  Background="Transparent" BorderThickness="0" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" >

            <!-- Стиль для карточек (убираем стандартную синюю заливку) -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="Transparent" Padding="0" Margin="0">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <!-- Панель для вывода карточек в ряд -->
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <!-- Внешний вид карточки -->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BrushSurface}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="8" 
                            Width="300" Height="220" Margin="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>

                            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                <TextBlock Text="{Binding LanguageName, StringFormat='Язык: {0}'}" 
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding Level, StringFormat='Уровень: {0}'}" 
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding TeacherName, StringFormat='Преподаватель: {0}'}" 
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                <!-- Кнопка "Подробнее" -->
                                <Button Content="Подробнее" HorizontalAlignment="Right" 
                                        Click="CourseDetails_Click" Tag="{Binding Id}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>