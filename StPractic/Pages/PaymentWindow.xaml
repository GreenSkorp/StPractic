<Window x:Class="StPractic.Pages.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата курса"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Оплата курса"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource BrushTextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- Информация о курсе -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="CourseTitleText"
                           Text="Название курса"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="PriceText"
                           Text="$0"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushAccent}"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Способ оплаты (имитация) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Способ оплаты"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       Margin="0,0,0,8"/>

            <ComboBox x:Name="PaymentMethodCombo"
                      Height="34"
                      SelectedIndex="0">
                <ComboBoxItem Content="Банковская карта"/>
                <ComboBoxItem Content="СБП"/>
                <ComboBoxItem Content="Электронный кошелёк"/>
            </ComboBox>
        </StackPanel>

        <!-- Поля карты (декор, не проверяем реально) -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="Номер карты"
                       FontSize="13"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="CardNumberBox"
                     Height="34"
                     VerticalContentAlignment="Center"
                     MaxLength="19"
                     ToolTip="Например: 4276 1234 5678 9012"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Срок (ММ/ГГ)"
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="ExpiryBox"
                             Height="34"
                             VerticalContentAlignment="Center"
                             MaxLength="5"
                             ToolTip="12/28"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CVC"
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="CvcBox"
                             Height="34"
                             VerticalContentAlignment="Center"
                             MaxLength="3"
                             ToolTip="123"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Отмена"
                    Padding="18,8"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BrushBorder}"
                    Foreground="{DynamicResource BrushTextPrimary}"
                    Cursor="Hand"/>
            <Button x:Name="PayBtn"
                    Content="Оплатить"
                    Padding="18,8"
                    Click="Pay_Click"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>