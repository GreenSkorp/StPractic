<Page x:Class="StPractic.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StPractic.Pages.LoginElements"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage" Background="{DynamicResource PrimaryColorBrushLightGrey}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
            <ToggleButton x:Name="StyleSwitchButtonLight" Grid.Row="0"  Margin="5 5 1 5" Width="80" Height="25" IsChecked="True"
                          Checked="LightTheme_Checked" Unchecked="DarkTheme_Checked"/>
            <ToggleButton x:Name="StyleSwitchButtonDark" Grid.Row="0"  Margin="1 5 5 5" Width="80" Height="25"
                          Checked="DarkTheme_Checked" Unchecked="LightTheme_Checked"/>
        </WrapPanel>
        <Border  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
            
            <TabControl  Background="{DynamicResource PrimaryColorBrushLightGrey}" BorderThickness="1" Margin="20"
                     Width="300" >
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Вход" Background="{DynamicResource PrimaryColorBrushLightGrey}" BorderThickness="0">
                    <local:LoginPageControl Loaded="LoginPageControl_Loaded"/>
                </TabItem>
                <TabItem Header="Регистрация" Background="{DynamicResource PrimaryColorBrushLightGrey}" BorderThickness="0">
                    <local:RegistrationPageControl/>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
