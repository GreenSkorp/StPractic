<UserControl x:Class="StPractic.Pages.UserElements.ProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
<Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Мой прогресс" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ProgressSummaryText" FontSize="14"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,15"/>

                            <DataGrid x:Name="ProgressGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Урок" Binding="{Binding LessonTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Балл" Binding="{Binding Score}" Width="80"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
</UserControl>
