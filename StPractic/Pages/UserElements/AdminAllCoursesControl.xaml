<UserControl x:Class="StPractic.Pages.UserElements.AdminAllCoursesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
<Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Все курсы" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,15"/>

                            <DataGrid x:Name="AllCoursesGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher}" Width="180"/>
                                    <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="100"/>
                                    <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
</UserControl>
