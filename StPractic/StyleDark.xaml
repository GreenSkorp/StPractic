<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Определение цветов -->
    <Color x:Key="PrimaryColorWhite">#FFFFFF</Color>
    <Color x:Key="PrimaryColorLightGrey">#F3F3F3</Color>
    <Color x:Key="PrimaryColorCyan">#0198AF</Color>
    <Color x:Key="PrimaryColorBlue">#233E76</Color>

    <Color x:Key="SecondColorLightGrey">#eaedeb</Color>
    <Color x:Key="SecondColorLightCyan">#4dc6c5</Color>
    <Color x:Key="SecondColorBlue">#275e9f</Color>
    <Color x:Key="SecondColorDarkGrey">#9197a3</Color>
    <Color x:Key="SecondColorDarkCyan">#256569</Color>
    <Color x:Key="SecondColorCyan">#006B80</Color>
    <Color x:Key="SecondColorDarkBlue">#193D57</Color>
    <Color x:Key="SecondColorOrange">#DD4B42</Color>


    <!-- Кисти -->
    <SolidColorBrush x:Key="PrimaryColorBrushWhite" Color="{StaticResource PrimaryColorWhite}"/>
    <SolidColorBrush x:Key="PrimaryColorBrushLightGrey" Color="{StaticResource PrimaryColorLightGrey}"/>
    <SolidColorBrush x:Key="PrimaryColorBrushCyan" Color="{StaticResource PrimaryColorCyan}"/>
    <SolidColorBrush x:Key="PrimaryColorBrushBlue" Color="{StaticResource PrimaryColorBlue}"/>

    <SolidColorBrush x:Key="SecondColorBrushLightGrey" Color="{StaticResource SecondColorLightGrey}"/>
    <SolidColorBrush x:Key="SecondColorBrushLightCyan" Color="{StaticResource SecondColorLightCyan}"/>
    <SolidColorBrush x:Key="SecondColorBrushBlue" Color="{StaticResource SecondColorBlue}"/>
    <SolidColorBrush x:Key="SecondColorBrushDarkGrey" Color="{StaticResource SecondColorDarkGrey}"/>
    <SolidColorBrush x:Key="SecondColorBrushDarkCyan" Color="{StaticResource SecondColorDarkCyan}"/>
    <SolidColorBrush x:Key="SecondColorBrushCyan" Color="{StaticResource SecondColorCyan}"/>
    <SolidColorBrush x:Key="SecondColorBrushDarkBlue" Color="{StaticResource SecondColorDarkBlue}"/>
    <SolidColorBrush x:Key="SecondColorBrushOrange" Color="{StaticResource SecondColorOrange}"/>





</ResourceDictionary>